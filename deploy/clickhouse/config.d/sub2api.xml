<clickhouse>
    <max_server_memory_usage_to_ram_ratio from_env="CLICKHOUSE_MAX_MEMORY_RATIO"/>
    <listen_host>0.0.0.0</listen_host>
    <logger>
        <level>warning</level>
        <size>100M</size>
        <count>5</count>
    </logger>
    <query_thread_log remove="1"/>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <text_log remove="1"/>
    <part_log remove="1"/>
</clickhouse>
